$mod std.http;

$ file_resp = http.get("http://127.0.0.1:8080/suite/file");
$ json_resp = http.get("http://127.0.0.1:8080/suite/json");
$ html_resp = http.get("http://127.0.0.1:8080/suite/html");
$ time_resp = http.get("http://127.0.0.1:8080/suite/time");
$ http_resp = http.get("http://127.0.0.1:8080/suite/http");
$ uuid_resp = http.get("http://127.0.0.1:8080/suite/uuid");
$ length_resp = http.get("http://127.0.0.1:8080/suite/length");
$ slice_resp = http.get("http://127.0.0.1:8080/suite/string-slice-negative");
$ len_diff_resp = http.get("http://127.0.0.1:8080/suite/string-len-diff");
$ file_status = file_resp["status"];
$ file_body = file_resp["body"];
$ json_status = json_resp["status"];
$ json_body = json_resp["body"];
$ html_status = html_resp["status"];
$ html_body = html_resp["body"];
$ time_status = time_resp["status"];
$ time_body = time_resp["body"];
$ http_status = http_resp["status"];
$ http_body = http_resp["body"];
$ uuid_status = uuid_resp["status"];
$ uuid_body = uuid_resp["body"];
$ length_status = length_resp["status"];
$ length_body = length_resp["body"];
$ slice_status = slice_resp["status"];
$ slice_body = slice_resp["body"];
$ len_diff_status = len_diff_resp["status"];
$ len_diff_body = len_diff_resp["body"];

$>> f"SUITE_FILE_STATUS={file_status}";
$>> f"SUITE_FILE_BODY={file_body}";
$>> f"SUITE_JSON_STATUS={json_status}";
$>> f"SUITE_JSON_BODY={json_body}";
$>> f"SUITE_HTML_STATUS={html_status}";
$>> f"SUITE_HTML_BODY={html_body}";
$>> f"SUITE_TIME_STATUS={time_status}";
$>> f"SUITE_TIME_BODY={time_body}";
$>> f"SUITE_HTTP_STATUS={http_status}";
$>> f"SUITE_HTTP_BODY={http_body}";
$>> f"SUITE_UUID_STATUS={uuid_status}";
$>> f"SUITE_UUID_BODY={uuid_body}";
$>> f"SUITE_LENGTH_STATUS={length_status}";
$>> f"SUITE_LENGTH_BODY={length_body}";
$>> f"SUITE_SLICE_STATUS={slice_status}";
$>> f"SUITE_SLICE_BODY={slice_body}";
$>> f"SUITE_LEN_DIFF_STATUS={len_diff_status}";
$>> f"SUITE_LEN_DIFF_BODY={len_diff_body}";
