$mod std.time;
$mod std.uuid;
$mod domains.news.data.news_queries;
$mod domains.news.data.news_types;

_$fn summary_from_row(row) -> NewsArticleSummary {
    $# NewsArticleSummary {
        article_id: row["article_id"],
        slug: row["slug"],
        title: row["title"],
        summary: row["summary"],
        status: row["status"],
        author_user_id: row["author_user_id"],
        published_at: row["published_at"],
        created_at: row["created_at"],
        updated_at: row["updated_at"],
        category_id: row["category_id"],
        category_slug: row["category_slug"],
        category_name: row["category_name"]
    };
}

_$fn article_from_row(row) -> NewsArticle {
    $# NewsArticle {
        article_id: row["article_id"],
        slug: row["slug"],
        title: row["title"],
        summary: row["summary"],
        body: row["body"],
        status: row["status"],
        author_user_id: row["author_user_id"],
        published_at: row["published_at"],
        created_at: row["created_at"],
        updated_at: row["updated_at"],
        category_id: row["category_id"],
        category_slug: row["category_slug"],
        category_name: row["category_name"]
    };
}

$fn list_public_articles() -> List<NewsArticleSummary> {
    $try {
        $ rows = news_queries.list_public_article_rows();
        $ articles = [];

        $for row in rows {
            articles.push(summary_from_row(row));
        }

        $# articles;
    } $catch err {
        $throw "database unavailable";
    }
}

$fn get_public_article(slug) {
    $try {
        $ rows = news_queries.find_public_article_row_by_slug(slug);
        $if rows.len() == 0 {
            $# null;
        }

        $# article_from_row(rows[0]);
    } $catch err {
        $throw "database unavailable";
    }
}

$fn list_admin_articles() -> List<NewsArticle> {
    $try {
        $ rows = news_queries.list_admin_article_rows();
        $ articles = [];

        $for row in rows {
            articles.push(article_from_row(row));
        }

        $# articles;
    } $catch err {
        $throw "database unavailable";
    }
}

$fn create_article(payload, principal) -> NewsArticle {
    $try {
        $ article_id = "article_" + uuid.v4();
        $ now = time.now();
        news_queries.insert_article_row(
            article_id,
            payload["slug"],
            payload["title"],
            payload["summary"],
            payload["body"],
            payload["category_id"],
            principal["subject"],
            now
        );

        $ rows = news_queries.find_admin_article_row_by_id(article_id);
        $# article_from_row(rows[0]);
    } $catch err {
        $throw "database unavailable";
    }
}

$fn update_article(article_id, payload) -> NewsArticle {
    $try {
        $ now = time.now();
        $ rows = news_queries.update_article_row(
            article_id,
            payload["slug"],
            payload["title"],
            payload["summary"],
            payload["body"],
            payload["category_id"],
            now
        );

        $if rows.len() == 0 {
            $throw "article not found";
        }

        $ article_rows = news_queries.find_admin_article_row_by_id(article_id);
        $# article_from_row(article_rows[0]);
    } $catch err {
        $if err == "article not found" {
            $throw err;
        }

        $throw "database unavailable";
    }
}

$fn publish_article(article_id) -> NewsArticle {
    $try {
        $ now = time.now();
        $ rows = news_queries.publish_article_row(article_id, now);

        $if rows.len() == 0 {
            $throw "article not found";
        }

        $ article_rows = news_queries.find_admin_article_row_by_id(article_id);
        $# article_from_row(article_rows[0]);
    } $catch err {
        $if err == "article not found" {
            $throw err;
        }

        $throw "database unavailable";
    }
}

$fn unpublish_article(article_id) -> NewsArticle {
    $try {
        $ now = time.now();
        $ rows = news_queries.unpublish_article_row(article_id, now);

        $if rows.len() == 0 {
            $throw "article not found";
        }

        $ article_rows = news_queries.find_admin_article_row_by_id(article_id);
        $# article_from_row(article_rows[0]);
    } $catch err {
        $if err == "article not found" {
            $throw err;
        }

        $throw "database unavailable";
    }
}
