$mod domains.auth.data.auth_user_queries;
$mod domains.auth.data.auth_user_types;

$fn find_user_by_username(username) {
    $try {
        $ rows = auth_user_queries.find_auth_user_row_by_username(username);

        $if rows.len() == 0 {
            $# null;
        }

        $ row = rows[0];
        $# AuthUser {
            user_id: row["user_id"],
            username: row["username"],
            password_hash: row["password_hash"],
            display_name: row["display_name"],
            team_id: row["team_id"],
            role: row["role"],
            is_active: row["is_active"]
        };
    } $catch err {
        $throw "database unavailable";
    }
}
