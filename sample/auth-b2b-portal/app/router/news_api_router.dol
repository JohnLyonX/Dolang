$mod std.auth.guard;
$mod domains.news.data.news_types;
$mod domains.news.services.news_service;

$GET("/news") list_public_news() -> List<NewsArticleSummary> {
    $# news_service.list_public_articles();
}

$GET("/news/:slug") get_public_news(slug) -> JSON {
    $ article = news_service.get_public_article(slug);
    $if article == null {
        $# $RES(404, {
            "status": 404,
            "code": "news_not_found",
            "message": "news article not found"
        });
    }

    $# article;
}

$GET("/admin/news") list_admin_news() -> List<NewsArticle> {
    $# news_service.list_admin_articles();
}

$POST("/admin/news") create_admin_news() -> JSON {
    $# $RES(201, news_service.create_article(body, guard.principal()));
}

$PUT("/admin/news/:id") update_admin_news(id) -> JSON {
    $# news_service.update_article(id, body);
}

$POST("/admin/news/:id/publish") publish_admin_news(id) -> JSON {
    $# news_service.publish_article(id);
}

$POST("/admin/news/:id/unpublish") unpublish_admin_news(id) -> JSON {
    $# news_service.unpublish_article(id);
}
