$mod domains.auth.data.auth_user_types;

$fn roles_for_user(user) -> List<String> {
    $# [user.role()];
}

$fn permissions_for_user(user) -> List<String> {
    $if user.role() == "admin" {
        $# ["project:create", "project:read", "audit:read", "news:create", "news:edit", "news:publish", "news:delete"];
    }

    $if user.role() == "editor" {
        $# ["news:create", "news:edit", "news:publish"];
    }

    $# ["project:read"];
}

$fn claims_for_user(user) -> Map {
    $# {
        "display_name": user.display_name(),
        "team_id": user.team_id(),
        "username": user.username(),
        "role": user.role()
    };
}

$fn public_user(user) -> PublicUser {
    $# PublicUser {
        user_id: user.user_id(),
        username: user.username(),
        display_name: user.display_name(),
        team_id: user.team_id(),
        role: user.role()
    };
}
