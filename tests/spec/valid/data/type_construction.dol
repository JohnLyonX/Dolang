$Type User {
    id: Int
    name: String
    email: String
    @HIDE password: String
}

$Type Post {
    id: Int
    title: String
    content: String
    author: User
}

$ user = User {
    id: 1,
    name: "John",
    email: "john@example.com",
    password: "secret",
};

$ post = Post {
    id: 7,
    title: "Hello",
};

$>> user.name;
$>> user.password;
$>> post.content;
post.author = user;
$>> post.author.email;
