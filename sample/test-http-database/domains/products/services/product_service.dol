$mod domains.products.data.category_types;
$mod domains.products.data.product_queries;
$mod domains.products.data.product_types;

$fn list_categories() -> List<Category> {
    $try {
        $ rows = product_queries.list_categories_rows();
        $ items = [];

        $for row in rows {
            items.push(Category {
                id: row["id"],
                name: row["name"],
            });
        }

        $# items;
    } $catch err {
        $throw "database unavailable";
    }
}

$fn list_products() -> List<Product> {
    $try {
        $ rows = product_queries.list_products_rows();
        $ items = [];

        $for row in rows {
            items.push(Product {
                id: row["id"],
                name: row["name"],
                price: row["price"],
                category_id: row["category_id"],
            });
        }

        $# items;
    } $catch err {
        $throw "database unavailable";
    }
}

$fn get_product_by_id(id) -> Product {
    $try {
        $ rows = product_queries.find_product_row_by_id(id);

        $if rows.len() == 0 {
            $throw "product not found";
        }

        $ row = rows[0];
        $# Product {
            id: row["id"],
            name: row["name"],
            price: row["price"],
            category_id: row["category_id"],
        };
    } $catch err {
        $if err == "product not found" {
            $throw err;
        }

        $throw "database unavailable";
    }
}

$fn create_product(name, price, category_id) -> Product {
    $try {
        $ rows = product_queries.insert_product_row(name, price, category_id);
        $ row = rows[0];

        $# Product {
            id: row["id"],
            name: row["name"],
            price: row["price"],
            category_id: row["category_id"],
        };
    } $catch err {
        $throw "database unavailable";
    }
}

$fn update_product(id, name, price, category_id) -> Product {
    $try {
        $ rows = product_queries.update_product_row(id, name, price, category_id);

        $if rows.len() == 0 {
            $throw "product not found";
        }

        $ row = rows[0];
        $# Product {
            id: row["id"],
            name: row["name"],
            price: row["price"],
            category_id: row["category_id"],
        };
    } $catch err {
        $if err == "product not found" {
            $throw err;
        }

        $throw "database unavailable";
    }
}

$fn delete_product(id) -> Map {
    $try {
        $ rows = product_queries.delete_product_row(id);

        $if rows.len() == 0 {
            $throw "product not found";
        }

        $# {
            "deleted": true,
            "id": id.to_int()
        };
    } $catch err {
        $if err == "product not found" {
            $throw err;
        }

        $throw "database unavailable";
    }
}
