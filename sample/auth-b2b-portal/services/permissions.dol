$fn roles_for_user(user) {
    $# [user["role"]];
}

$fn permissions_for_user(user) {
    $if user["role"] == "admin" {
        $# ["project:create", "project:read", "audit:read"];
    }

    $# ["project:read"];
}

$fn claims_for_user(user) {
    $# {
        "display_name": user["display_name"],
        "team_id": user["team_id"],
        "username": user["username"],
        "role": user["role"]
    };
}

$fn public_user(user) {
    $# {
        "user_id": user["user_id"],
        "username": user["username"],
        "display_name": user["display_name"],
        "team_id": user["team_id"],
        "role": user["role"]
    };
}
