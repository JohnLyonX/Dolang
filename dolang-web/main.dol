$main() {
    // 挂载API 路由
	$HTTP("/v1/api/").link("routers.api");


    // 静态资源
    $STATIC("/css","pages.css");
    $STATIC("/ico","pages.ico");
    $STATIC("/download","pages.download");
    $STATIC("/js","pages.js");

    $GET("/") index() -> HTML {
        $ web = $HTML().link("pages.dolang");
        $# web;
    }

    $GET("/cn") index() -> HTML {
        $ web = $HTML().link("pages.dolang-cn");
        $# web;
    }
}
