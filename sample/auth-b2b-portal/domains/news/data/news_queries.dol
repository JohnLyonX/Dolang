$mod shared.db.queries;

$fn list_public_article_rows() -> List<Map> {
    $# queries.safe_query(
        "SELECT a.article_id, a.slug, a.title, a.summary, a.status, a.author_user_id, a.published_at, a.created_at, a.updated_at, c.category_id, c.slug AS category_slug, c.name AS category_name FROM news_articles a JOIN news_categories c ON c.category_id = a.category_id WHERE a.status = 'published' ORDER BY a.published_at DESC, a.created_at DESC",
        []
    );
}

$fn find_public_article_row_by_slug(slug) -> List<Map> {
    $# queries.safe_query(
        "SELECT a.article_id, a.slug, a.title, a.summary, a.body, a.status, a.author_user_id, a.published_at, a.created_at, a.updated_at, c.category_id, c.slug AS category_slug, c.name AS category_name FROM news_articles a JOIN news_categories c ON c.category_id = a.category_id WHERE a.slug = $1 AND a.status = 'published' LIMIT 1",
        [slug]
    );
}

$fn list_admin_article_rows() -> List<Map> {
    $# queries.safe_query(
        "SELECT a.article_id, a.slug, a.title, a.summary, a.body, a.status, a.author_user_id, a.published_at, a.created_at, a.updated_at, c.category_id, c.slug AS category_slug, c.name AS category_name FROM news_articles a JOIN news_categories c ON c.category_id = a.category_id ORDER BY a.created_at DESC, a.updated_at DESC",
        []
    );
}

$fn find_admin_article_row_by_id(article_id) -> List<Map> {
    $# queries.safe_query(
        "SELECT a.article_id, a.slug, a.title, a.summary, a.body, a.status, a.author_user_id, a.published_at, a.created_at, a.updated_at, c.category_id, c.slug AS category_slug, c.name AS category_name FROM news_articles a JOIN news_categories c ON c.category_id = a.category_id WHERE a.article_id = $1 LIMIT 1",
        [article_id]
    );
}

$fn insert_article_row(article_id, slug, title, summary, body, category_id, author_user_id, now) -> List<Map> {
    $# queries.safe_query(
        "INSERT INTO news_articles (article_id, slug, title, summary, body, category_id, status, author_user_id, published_at, created_at, updated_at) VALUES ($1, $2, $3, $4, $5, $6, 'draft', $7, NULL, $8, $9) RETURNING article_id",
        [article_id, slug, title, summary, body, category_id, author_user_id, now, now]
    );
}

$fn update_article_row(article_id, slug, title, summary, body, category_id, now) -> List<Map> {
    $# queries.safe_query(
        "UPDATE news_articles SET slug = $2, title = $3, summary = $4, body = $5, category_id = $6, updated_at = $7 WHERE article_id = $1 RETURNING article_id",
        [article_id, slug, title, summary, body, category_id, now]
    );
}

$fn publish_article_row(article_id, now) -> List<Map> {
    $# queries.safe_query(
        "UPDATE news_articles SET status = 'published', published_at = $2, updated_at = $2 WHERE article_id = $1 RETURNING article_id",
        [article_id, now]
    );
}

$fn unpublish_article_row(article_id, now) -> List<Map> {
    $# queries.safe_query(
        "UPDATE news_articles SET status = 'draft', published_at = NULL, updated_at = $2 WHERE article_id = $1 RETURNING article_id",
        [article_id, now]
    );
}
