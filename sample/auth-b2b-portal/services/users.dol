$mod std.env;
$mod std.postgres;

_$fn database_url() -> String {
    $if env.has("APP_DATABASE_URL") {
        $# env.get("APP_DATABASE_URL");
    }

    $# env.get("SESSION_DATABASE_URL");
}

$fn find_by_username(username) {
    $ conn = postgres.connect(database_url());
    $ rows = conn.query(
        "SELECT user_id, username, password_hash, display_name, team_id, role, is_active FROM app_users WHERE username = $1 LIMIT 1",
        [username]
    );
    conn.close();

    $if rows.len() == 0 {
        $# null;
    }

    $# rows[0];
}
