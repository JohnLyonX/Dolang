$mod domains.auth.services.auth_service;

$POST("/register") register() -> JSON {
    $try {
        $# $RES(201, auth_service.register(body["username"], body["email"], body["password"]));
    } $catch err {
        $if err == "username already exists" {
            $# $RES(409, {
                "status": 409,
                "code": "username_exists",
                "message": "username already exists"
            });
        }

        $if err == "email already exists" {
            $# $RES(409, {
                "status": 409,
                "code": "email_exists",
                "message": "email already exists"
            });
        }

        $throw err;
    }
}

$POST("/login") login() -> JSON {
    $ user = auth_service.authenticate(body["username"], body["password"]);
    $if user == null {
        $# $RES(401, {
            "status": 401,
            "code": "invalid_credentials",
            "message": "username or password is incorrect"
        });
    }

    $# auth_service.issue_login(user);
}
