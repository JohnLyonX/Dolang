$mod shared.db.queries;

$fn list_user_rows() -> List<Map> {
    $# queries.safe_query("SELECT id, name, email, created_at::text AS created_at FROM users ORDER BY id", []);
}

$fn find_user_row_by_id(id) -> List<Map> {
    $# queries.safe_query(
        "SELECT id, name, email, created_at::text AS created_at FROM users WHERE id::bigint = $1",
        [id.to_int()]
    );
}

$fn insert_user_row(name, email) -> List<Map> {
    $# queries.safe_query(
        "INSERT INTO users (name, email) VALUES ($1, $2) RETURNING id, name, email, created_at::text AS created_at",
        [name, email]
    );
}

$fn update_user_row(id, name, email) -> List<Map> {
    $# queries.safe_query(
        "UPDATE users SET name = $2, email = $3 WHERE id::bigint = $1 RETURNING id, name, email, created_at::text AS created_at",
        [id.to_int(), name, email]
    );
}

$fn delete_user_row(id) -> List<Map> {
    $# queries.safe_query(
        "DELETE FROM users WHERE id::bigint = $1 RETURNING id",
        [id.to_int()]
    );
}
