$GET("/getUsers") getUsers() -> JSON{
	$result = $JSON {
		"id": 1,
		"name": "John Lyon"
	};
	$# result;
}


$GET("/getUser") getUser(id) -> JSON{
    $ result = $JSON{};

    $if id == '1' {
        result = $JSON {
            "id": 1,
		    "name": "John Lyon"
        };
        $>>FILE("./logs/JSON.md", "LOG: 请求了 \n","A", 1024);

        $ log_size = $<<FILE("./logs/JSON.md").size();
        $>> f"当前文件字节大小 {log_size}";
        $if log_size >= 1024 {
            $>>FILE("./logs/JSON.md", "DEL");
        }

        $>> "LOG 收到请求";
        $# result;
    }


    $# $JSON{"Null": "Not Users"};


}
