$mod config.database;

$fn safe_query(sql, params) -> List<Map> {
    $try {
        $ conn = database.connect_db();
        $try {
            $ rows = conn.query(sql, params);
            conn.close();
            $# rows;
        } $catch err {
            conn.close();
            $throw "database unavailable";
        }
    } $catch err {
        $throw "database unavailable";
    }
}

$fn safe_execute(sql, params) -> Map {
    $try {
        $ conn = database.connect_db();
        $try {
            $ result = conn.execute(sql, params);
            conn.close();
            $# {
                "ok": true,
                "result": result
            };
        } $catch err {
            conn.close();
            $throw "database unavailable";
        }
    } $catch err {
        $throw "database unavailable";
    }
}
