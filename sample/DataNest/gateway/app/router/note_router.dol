$mod domains.note.data.note_types;
$mod domains.note.services.note_gateway_service;

_$fn grpc_error_response(err) {
    $if err.type() != "Map" {
        $throw err;
    }

    $if err.contains_key("status") != true {
        $throw err;
    }

    $if err["status"] == 404 {
        $# $RES(404, {
            "status": 404,
            "code": "note_not_found",
            "message": err["error"]["message"]
        });
    }

    $if err["status"] == 400 {
        $# $RES(400, {
            "status": 400,
            "code": "invalid_argument",
            "message": err["error"]["message"]
        });
    }

    $if err["status"] == 409 {
        $# $RES(409, {
            "status": 409,
            "code": "already_exists",
            "message": err["error"]["message"]
        });
    }

    $if err["status"] == 503 {
        $# $RES(503, {
            "status": 503,
            "code": "service_unavailable",
            "message": err["error"]["message"]
        });
    }

    $throw err;
}

$GET("/notes") list_notes() -> List<NoteSummary> {
    $# note_gateway_service.list_notes();
}

$GET("/notes/:id") get_note(id) -> JSON {
    $try {
        $# note_gateway_service.get_note(id);
    } $catch err {
        $# grpc_error_response(err);
    }
}

$GET("/notes/search") search_notes() -> List<NoteSummary> {
    $# note_gateway_service.search_notes(query["q"]);
}

$GET("/tags") list_tags() -> List<Tag> {
    $# note_gateway_service.list_tags();
}

$POST("/notes") create_note() -> JSON {
    $try {
        $# $RES(201, note_gateway_service.create_note(body));
    } $catch err {
        $# grpc_error_response(err);
    }
}

$POST("/tags") create_tag() -> JSON {
    $try {
        $# $RES(201, note_gateway_service.create_tag(body));
    } $catch err {
        $# grpc_error_response(err);
    }
}

$POST("/notes/:id/tags") attach_tag(id) -> JSON {
    $try {
        $# note_gateway_service.attach_tag(id, body["tag_id"]);
    } $catch err {
        $# grpc_error_response(err);
    }
}
